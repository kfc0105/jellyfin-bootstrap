# bootstrap.sh copies this file to .env and fills in the values it can detect.
# .env holds secrets. Leave it out of git and out of chat logs.

PUID=1000
PGID=1000
TZ=UTC

# Folders next to this file. Use absolute paths if you want them somewhere else.
CONFIG_ROOT=./config
MEDIA_ROOT=./media

# 0.0.0.0 publishes on every network interface of this computer.
# Set a LAN address (for example 192.168.1.20) to limit that.
BIND_ADDRESS=0.0.0.0

JELLYFIN_PORT=8096
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
SEERR_PORT=5055

# The qBittorrent listen port and the published port are the same number.
# Prowlarr is published on PROWLARR_PORT and listens on 9696 inside the VPN container.
QBITTORRENT_PORT=8090
PROWLARR_PORT=9696

QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=replace-me

# ProtonVPN WireGuard private key.
# Create one at https://account.proton.me/u/0/vpn/WireGuard
# and paste the PrivateKey value here. One key works for every Proton server.
# Leave this empty to start Jellyfin and the library apps without the VPN.
WIREGUARD_PRIVATE_KEY=

# Country Gluetun requests from Proton. Example: Japan
VPN_SERVER_COUNTRIES=United States
